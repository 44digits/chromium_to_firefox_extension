# Chromium-to-Firefox extension.
#
# This .desktop file starts the Python relay server before launching Chromium.
# User: 44digits
# Date: 2026-10-15
[Desktop Entry]
Version=1.0
Type=Application
Name=Chromium Firefox Relay
Comment=Launches the Python URL relay server and Chromium
Exec=bash -c "python3 ~/bin/chromium_to_firefox_extension/firefox_relay_server.py & chromium"
Icon=chromium-browser
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
